							<property name="sizeHint" stdset="0">
								<size>
									<width>40</width>
									<height>20</height>
								</size>
							</property>
						</spacer>
					</item>
					<item>
						<widget class="QPushButton" name="pushButton_start">
							<property name="text">
								<string>Start</string>
							</property>
						</widget>
					</item>
					<item>
						<widget class="QPushButton" name="pushButton_stop">
							<property name="text">
